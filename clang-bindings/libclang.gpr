library project libclang is
   type Any_Library_Type is ("static", "relocatable", "static-pic");
   Library_Type : Any_Library_Type := external ("LIBRARY_TYPE", "static");

   --  Although there is no real C++ source to be compiled with this project,
   --  the C++ language is necessary to make users of this library aware that a
   --  C++ toolchain is required to properly link against libstdc++, which the
   --  actual libclang library depends-on.
   for Languages use ("Ada", "C++");

   for Source_Dirs use (".");

   for Library_Kind use Library_Type;
   for Library_Dir use "libclang." & Project'Library_Kind;
   for Library_Name use "libclang";

   for Object_Dir use "obj-libclang." & Library_Type;

   case Library_Type is
      when "relocatable" =>
         for Library_Options use ("-lclang");

      when others =>
         null;
   end case;

end libclang;
